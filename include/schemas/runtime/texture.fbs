namespace engine.schema;

enum TextureEncoding:ubyte { basis, native }
enum TextureFormat:ubyte { auto_format, rgba8, bc7, astc4x4, etc2, rgba16f, rg16f, etc2_rgb }

enum TextureChunkEncoding:ubyte { raw, zstd, shuffled_zstd }

struct TextureChunk {
    offset:uint;
    size:uint;
    stored_offset:uint;
    stored_size:uint;
    encoding:TextureChunkEncoding;
}

struct TextureSubresourceData {
    mip:uint;
    face:uint;
    offset:ulong;
    size:ulong;
}

table TextureData {
    schema_version:uint = 0;
    path:string (required);
    width:uint;
    height:uint;
    mip_count:uint = 1;
    srgb:bool = true;
    encoding:TextureEncoding = basis;
    format:TextureFormat = auto_format;
    data:[ubyte] (required);
    cube_map:bool = false;
    // Native 2D arrays use face as the layer index; cubes remain exactly six faces.
    array_layers:uint = 1;
    subresources:[TextureSubresourceData];
    // Native logical offsets address the uncompressed GPU blocks.
    chunks:[TextureChunk];
}

root_type TextureData;
file_identifier "ETEX";
