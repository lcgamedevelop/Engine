include "common.fbs";
namespace engine.schema;

struct MeshVertex {
    x:float;
    y:float;
    z:float;
    nx:float;
    ny:float;
    nz:float;
}

struct MeshSubmesh {
    first_index:uint;
    index_count:uint;
    material_slot:uint;
}

struct SkinInfluence {
    j0:ushort;
    j1:ushort;
    j2:ushort;
    j3:ushort;
    w0:float;
    w1:float;
    w2:float;
    w3:float;
}

// Meshlets retain ordinary topology and address the same vertex array.
struct Meshlet {
    first_index:uint;
    index_count:uint;
    center:Vec3;
    radius:float;
    cone_axis:Vec3;
    cone_cutoff:float;
}

struct MeshletRange {
    first_meshlet:uint;
    meshlet_count:uint;
}

table MeshletData {
    indices:[uint] (required);
    meshlets:[Meshlet] (required);
    submeshes:[MeshletRange] (required);
}

// Additional static rendering topology; all indices address MeshData.vertices.
table MeshLodData {
    screen_height:float;
    indices:[uint] (required);
    submeshes:[MeshSubmesh];
    meshlets:MeshletData;
}

table MeshData {
    schema_version:uint = 2;
    path:string (required);
    vertices:[MeshVertex] (required);
    indices:[uint] (required);
    texcoords:[Vec2];
    tangents:[Vec4];
    colors:[Color];
    submeshes:[MeshSubmesh];
    skeleton_guid:string;
    skin:[SkinInfluence];
    // Column-major bind transform from mesh local space to skeleton/model space.
    mesh_to_skeleton:[float];
    lightmap_texcoords:[Vec2];
    lods:[MeshLodData];
    meshlets:MeshletData;
}

root_type MeshData;
file_identifier "EMS2";
