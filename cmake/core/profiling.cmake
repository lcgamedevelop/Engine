option(ENGINE_ENABLE_TRACY_FUNCTIONS "Record function scopes in Tracy builds" OFF)
option(ENGINE_WEB_HEAP_OBSERVATION "Observe linked allocations in the Web runtime" OFF)
option(ENGINE_MACOS_HEAP_OBSERVATION "Observe system heap allocations in macOS diagnostic hosts" OFF)
set(ENGINE_TRACY_MEMORY_MODE off CACHE STRING "Engine memory profiling (off, totals, detailed)")
set_property(CACHE ENGINE_TRACY_MEMORY_MODE PROPERTY STRINGS off totals detailed)
if(NOT ENGINE_TRACY_MEMORY_MODE MATCHES "^(off|totals|detailed)$")
    message(FATAL_ERROR "ENGINE_TRACY_MEMORY_MODE must be off, totals, or detailed")
endif()
if(NOT ENGINE_TRACY_MEMORY_MODE STREQUAL "off" AND NOT ENGINE_ENABLE_RUNTIME_DEPS)
    message(FATAL_ERROR "Memory profiling requires ENGINE_ENABLE_RUNTIME_DEPS")
endif()
if(ENGINE_TRACY_MEMORY_MODE STREQUAL "detailed" AND NOT ENGINE_ENABLE_TRACY)
    message(FATAL_ERROR "Detailed memory profiling requires ENGINE_ENABLE_TRACY")
endif()
if(ENGINE_WEB_HEAP_OBSERVATION AND (NOT EMSCRIPTEN OR NOT ENGINE_BUILD_APP OR
        ENGINE_TRACY_MEMORY_MODE STREQUAL "off"))
    message(FATAL_ERROR "Web heap observation requires a Web app with memory profiling")
endif()
if(ENGINE_MACOS_HEAP_OBSERVATION AND (NOT CMAKE_SYSTEM_NAME STREQUAL "Darwin" OR
        NOT ENGINE_BUILD_APP OR ENGINE_TRACY_MEMORY_MODE STREQUAL "off"))
    message(FATAL_ERROR "macOS heap observation requires a macOS app with memory profiling")
endif()

function(engine_add_memory_profiling)
    add_library(engine_memory_profile STATIC src/engine/runtime/performance/memory_profiling.cpp)
    add_library(engine::memory_profile ALIAS engine_memory_profile)
    target_include_directories(engine_memory_profile PUBLIC "${PROJECT_SOURCE_DIR}/include/engine")
    target_compile_features(engine_memory_profile PUBLIC cxx_std_20)
    engine_apply_options(engine_memory_profile)
    if(NOT ENGINE_TRACY_MEMORY_MODE STREQUAL "off")
        target_compile_definitions(engine_memory_profile PUBLIC ENGINE_ENABLE_MEMORY_PROFILING=1)
    endif()
    if(ENGINE_TRACY_MEMORY_MODE STREQUAL "detailed")
        target_compile_definitions(engine_memory_profile PRIVATE
            ENGINE_ENABLE_MEMORY_PROFILING_DETAILS=1)
    endif()
    if(ENGINE_WEB_HEAP_OBSERVATION OR ENGINE_MACOS_HEAP_OBSERVATION)
        target_sources(engine_memory_profile PRIVATE
            src/engine/runtime/performance/heap_profiling.cpp)
        target_compile_definitions(engine_memory_profile PRIVATE
            ENGINE_ENABLE_GENERAL_HEAP_OBSERVATION=1)
    endif()
    if(ENGINE_MACOS_HEAP_OBSERVATION)
        include("${PROJECT_SOURCE_DIR}/cmake/platforms/macos_heap.cmake")
        engine_configure_macos_heap_observation(engine_memory_profile)
    endif()
endfunction()

# Tracy stays private. Header definitions use a consistent standard-library probe.
function(engine_enable_profiling target)
    target_include_directories(${target} PRIVATE "${PROJECT_SOURCE_DIR}/src/engine")
    if(target STREQUAL "engine_core")
        if(ENGINE_ENABLE_TRACY AND ENGINE_ENABLE_TRACY_FUNCTIONS)
            target_compile_definitions(${target} PUBLIC ENGINE_ENABLE_FUNCTION_PROBES=1)
        endif()
        return()
    endif()
    if(ENGINE_ENABLE_TRACY)
        target_compile_definitions(${target} PRIVATE ENGINE_ENABLE_TRACY=1)
        if(ENGINE_ENABLE_TRACY_FUNCTIONS)
            target_compile_definitions(${target} PRIVATE ENGINE_ENABLE_TRACY_FUNCTIONS=1)
            get_target_property(_profile_target_type ${target} TYPE)
            if(_profile_target_type MATCHES "^(EXECUTABLE|SHARED_LIBRARY)$")
                target_sources(${target} PRIVATE
                    "${PROJECT_SOURCE_DIR}/src/engine/runtime/performance/tracy_function_profiling.cpp")
            endif()
        endif()
        target_link_libraries(${target} PRIVATE Tracy::TracyClient)
    endif()
endfunction()
