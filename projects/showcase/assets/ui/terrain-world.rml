<rml><head><title>Terrain world</title><style>
body { margin: 0; width: 100%; height: 100%; pointer-events: none; font-family: body; color: #eef3fa; font-size: 16px; }
.panel { position: absolute; left: 24px; top: 80px; width: 360px; padding: 16px; background: #17263bea; pointer-events: auto; }
button { display: inline-block; width: 145px; margin: 4px; padding: 8px; background: #365572; color: #eef3fa; border-width: 0; tab-index: auto; font-family: body; font-size: 16px; }
button:hover, button:focus { background: #466e92; }
p { display: block; margin: 12px 0 0; }
</style></head><body><div class="panel"><h2>Terrain world / 8 km</h2><button id="world-0">Southwest</button><button id="world-1">Southeast</button><button id="world-2">Northeast</button><button id="world-3">Northwest</button><p id="world-status"></p></div></body></rml>
