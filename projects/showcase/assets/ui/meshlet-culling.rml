<rml><head><title>Meshlet culling</title><style>
body { margin: 0; width: 100%; height: 100%; pointer-events: none; font-family: body; color: #eef3fa; font-size: 14px; }
.panel { position: absolute; left: 24px; top: 80px; width: 400px; padding: 12px; background: #17263bea; pointer-events: auto; }
button { display: block; padding: 8px; background: #365572; color: #eef3fa; border-width: 0; tab-index: auto; font-family: body; font-size: 16px; }
button:hover, button:focus { background: #466e92; }
p { display: block; margin: 8px 0 0; }
</style></head><body><div class="panel"><button id="meshlet-toggle">Scene Meshlets: OFF</button><p id="meshlet-status"></p></div></body></rml>
